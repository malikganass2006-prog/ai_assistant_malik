# ============================================================
# Malik AI Assistant — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# All API keys are configured HERE — never in the frontend UI.
#
# Quick start:
#   1. cp .env.example .env
#   2. Add your GROQ_API_KEY (free at console.groq.com)
#   3. cd backend && python main.py
#   4. Open http://localhost:8000
# ============================================================


# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
ENVIRONMENT=production


# ── AI API Keys (at least GROQ_API_KEY required) ─────────────
#
# Groq — FREE, fast, powers: LLM chat + Whisper STT + Vision
# Get yours at: https://console.groq.com
GROQ_API_KEY=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

# OpenAI — Optional, enables GPT-4o Vision (better image analysis)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ElevenLabs — Optional, enables premium natural-sounding TTS
# Get yours at: https://elevenlabs.io
ELEVENLABS_API_KEY=sk_e1cbc2827143a63bb132419a991fd051061c93cfbfe13b69


# ── LLM Configuration ────────────────────────────────────────
# Provider: "groq" (recommended, free) or "openai"
LLM_PROVIDER=groq

# Groq models: llama-3.3-70b-versatile | llama-3.1-8b-instant | mixtral-8x7b-32768
# OpenAI models: gpt-4o | gpt-4o-mini
LLM_MODEL=llama-3.3-70b-versatile

# Max tokens in AI response (higher = longer replies)
LLM_MAX_TOKENS=2048

# Temperature: 0.0 = precise/factual, 1.0 = creative/varied
LLM_TEMPERATURE=0.7


# ── Text-to-Speech (TTS) ─────────────────────────────────────
# Provider: "gtts" (free, requires internet) or "elevenlabs" (premium)
TTS_PROVIDER=gtts

# Language for gTTS: "en" (English) or "ur" (Urdu)
TTS_LANGUAGE=en

# ElevenLabs voice ID (only used when TTS_PROVIDER=elevenlabs)
# Default: Rachel voice. Browse voices at elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM


# ── Speech-to-Text (STT) ─────────────────────────────────────
# Provider: "webspeech" (browser built-in, no key needed)
#           "whisper"   (via Groq or OpenAI, more accurate)
STT_PROVIDER=webspeech

# Whisper model (only used when STT_PROVIDER=whisper via OpenAI)
WHISPER_MODEL=whisper-1


# ── Conversation Memory ───────────────────────────────────────
# Type: "file"   — persists history to disk across restarts
#       "memory" — in-RAM only, clears on restart
MEMORY_TYPE=file

# Maximum number of messages to keep per session
MEMORY_MAX_HISTORY=50

# File path for persisted conversation history (MEMORY_TYPE=file)
MEMORY_FILE_PATH=conversation_history.json


# ── Vision ────────────────────────────────────────────────────
# Provider: "groq" (uses llama-3.2-11b-vision-preview)
#           "openai" (uses gpt-4o-mini, better accuracy)
# Falls back to whichever key is available
VISION_PROVIDER=groq
